{
  "info": {
    "name": "Space Bounty Hunters API",
    "description": "Run requests in order (folder runner). Needs the API running at base_url.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Wanted Criminals",
      "item": [
        {
          "name": "List all criminals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Seeded >= 5 criminals', () => pm.expect(body.length).to.be.at.least(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: min_reward + armed, sort -reward",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?min_reward=5000&armed=true&sort=-reward",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "armed",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "-reward"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('All armed and reward >= 5000', () => body.forEach(c => { pm.expect(c.armed).to.be.true; pm.expect(c.reward).to.be.at.least(5000); }));",
                  "pm.test('Sorted by reward descending', () => { for (let i = 1; i < body.length; i++) pm.expect(body[i-1].reward).to.be.at.least(body[i].reward); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: reward range + escape_master",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?min_reward=5000&max_reward=50000&escape_master=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "max_reward",
                  "value": "50000"
                },
                {
                  "key": "escape_master",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Matches filters', () => body.forEach(c => { pm.expect(c.escape_master).to.be.true; pm.expect(c.reward).to.be.within(5000, 50000); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: has_crew=false, sort reward ascending",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?has_crew=false&sort=reward",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "has_crew",
                  "value": "false"
                },
                {
                  "key": "sort",
                  "value": "reward"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Sorted ascending', () => { for (let i = 1; i < body.length; i++) pm.expect(body[i-1].reward).to.be.at.most(body[i].reward); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Criminal details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/1/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Has expected fields', () => { pm.expect(body.id).to.eql(1); pm.expect(body).to.have.all.keys('id','name','nickname','reward','latitude','longitude','last_known_note','difficulty','armed','has_crew','escape_master'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Criminal not found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/9999/",
              "host": [
