            }
          ]
        },
        {
          "name": "INVALID: bad sort value (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?sort=nickname",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
