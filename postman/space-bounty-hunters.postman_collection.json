          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "INVALID: non-numeric criminal id (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/abc/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                "abc"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Hunt Logs (CRUD)",
      "item": [
        {
          "name": "List all hunt logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Seeded >= 10 logs', () => pm.expect(body.length).to.be.at.least(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "List hunt logs by criminal_id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/?criminal_id=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts"
              ],
              "query": [
                {
                  "key": "criminal_id",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Only criminal 1', () => { pm.expect(body.length).to.be.above(0); body.forEach(h => pm.expect(h.criminal_id).to.eql(1)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create hunt log",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/hunts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\",\n  \"created_at\": \"2000-01-01T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('hunt_id', body.id);",
                  "pm.test('Server generated created_at (client value ignored)', () => { pm.expect(body.created_at).to.be.a('string'); pm.expect(body.created_at).to.not.include('2000-01-01'); });",
                  "pm.test('Fields saved', () => { pm.expect(body.criminal_id).to.eql(3); pm.expect(body.success).to.be.false; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get hunt log",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/{{hunt_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Correct id', () => pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('hunt_id'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update hunt log (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/hunts/{{hunt_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"success\": true,\n  \"notes\": \"Recaptured after a second chase.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Updated', () => { pm.expect(body.success).to.be.true; pm.expect(body.notes).to.include('Recaptured'); });"
                ]
              }
            }
          ]
        },
